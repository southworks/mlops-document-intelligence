# Azure Document Intelligence (REQUIRED for production)
# Get from Azure Portal > Document Intelligence resource > Keys & Endpoints
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here
AZURE_COMPOSE_MODEL_ID=your-compose-model-id-here
DOCUMENT_INTELLIGENCE_SAS_TTL_MINUTES=5

# Azure Storage (REQUIRED)
# Use Azurite or a real Azure Storage account connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=documents
AZURE_STORAGE_QUEUE_NAME=document-processing
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_VISIBILITY_TIMEOUT_SECONDS=120

# Database (for container-based setup)
DATABASE_URL=postgresql://procurement_user:procurement_password@postgres:5432/procurement_db

# API Settings
API_PORT=8000
API_HOST=0.0.0.0

# Frontend Settings
VITE_API_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# ModelAdmin external boundary settings
MODELADMIN_EXTERNAL_ENDPOINT=
MODELADMIN_EXTERNAL_API_KEY=
BOUNDARY_API_KEY=
MODELADMIN_EXTERNAL_TIMEOUT_SECONDS=5
