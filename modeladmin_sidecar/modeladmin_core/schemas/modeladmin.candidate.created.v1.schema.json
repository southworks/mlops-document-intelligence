{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeladmin.candidate.created.v1",
  "title": "ModelAdmin Candidate Created V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_name",
    "contract_version",
    "document_id",
    "compose_model_id",
    "idempotency_key",
    "blob_path",
    "processed_blob_path",
    "source_channel",
    "predicted_document_type",
    "has_low_confidence",
    "trigger_reason",
    "emitted_at"
  ],
  "properties": {
    "event_name": { "const": "modeladmin.candidate.created.v1" },
    "contract_version": { "const": "1.0.0" },
    "document_id": { "type": "string", "minLength": 1 },
    "compose_model_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "blob_path": { "type": "string", "minLength": 1 },
    "processed_blob_path": { "type": "string", "minLength": 1 },
    "source_channel": { "type": "string", "minLength": 1 },
    "predicted_document_type": { "type": "string", "minLength": 1 },
    "classification_confidence": { "type": ["number", "null"] },
    "has_low_confidence": { "type": "boolean" },
    "trigger_reason": { "type": "string", "minLength": 1 },
    "original_filename": { "type": ["string", "null"] },
    "structured_data": { "type": ["object", "null"] },
    "processing_error": { "type": ["string", "null"] },
    "emitted_at": { "type": "string", "format": "date-time" }
  }
}
