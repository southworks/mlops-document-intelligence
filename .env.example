# =============================================================
# .env.example — copy to .env.local and fill in real values
# DO NOT commit .env.local
# =============================================================

# ── Azure Document Intelligence (required) ───────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here
AZURE_COMPOSE_MODEL_ID=your-compose-model-id-here
DOCUMENT_INTELLIGENCE_SAS_TTL_MINUTES=5

# ── Azure Storage (required) ─────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=documents
# Queue Storage no longer used — document processing runs as a FastAPI background task.
TRAINING_DATA_CONTAINER=training-data

# ── Backend / API ─────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
DATABASE_URL=sqlite:////app/data/invoice_ocr.db
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=true

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── ModelAdmin Sidecar boundary settings ─────────────────────
MODELADMIN_EXTERNAL_ENDPOINT=http://modeladmin-service:8100
MODELADMIN_EXTERNAL_API_KEY=
MODELADMIN_EXTERNAL_TIMEOUT_SECONDS=5
BOUNDARY_API_KEY=

# ── ModelAdmin confidence thresholds ─────────────────────────
# Scores below these values trigger review-candidate creation (Stage 2 confidence gate).
# Defaults to 0.70 if unset. Raise to capture more borderline documents for review.
CONFIDENCE_THRESHOLD_INVOICE=0.70
CONFIDENCE_THRESHOLD_PO=0.70
CONFIDENCE_THRESHOLD_GRN=0.70
