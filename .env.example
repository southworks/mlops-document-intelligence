# =============================================================
# .env.example — copy to .env.local and fill in real values
# DO NOT commit .env.local
# =============================================================

# ── Azure Document Intelligence (required) ───────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here
AZURE_COMPOSE_MODEL_ID=your-compose-model-id-here
DOCUMENT_INTELLIGENCE_SAS_TTL_MINUTES=5

# ── Azure Storage (required) ─────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=documents
# Queue Storage no longer used — document processing runs as a FastAPI background task.
TRAINING_DATA_CONTAINER=training-data

# ── Backend / API ─────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres-service:5432/mlops_backend
MODELADMIN_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres-service:5432/mlops_modeladmin
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=true

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── ModelAdmin Sidecar boundary settings ─────────────────────
MODELADMIN_EXTERNAL_ENDPOINT=http://modeladmin-service:8100
MODELADMIN_EXTERNAL_API_KEY=
MODELADMIN_EXTERNAL_TIMEOUT_SECONDS=5
BOUNDARY_API_KEY=

# ── ModelAdmin confidence threshold ──────────────────────────
# Classification confidence below this value triggers a review candidate (Stage 2 gate).
# Owned by the production app; defaults to 0.75 if unset.
MODELADMIN_CONFIDENCE_THRESHOLD=0.75
